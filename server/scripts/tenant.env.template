# Filled in by provision-tenant.sh — DB_DATABASE and PORT are unique
# per tenant, everything else is either shared config or gets
# auto-generated on first run (JWT_SECRET, ENCRYPTION_KEY — see
# bootstrap-env.ts).

NODE_ENV=production
PORT=__PORT__

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=doccapture
DB_PASSWORD=__DB_PASSWORD__
DB_DATABASE=__DB_DATABASE__

# Same license server for every tenant — it's how you tell them apart
# and enforce per-tenant device limits, see server/src/modules/license/.
LICENSE_SERVER_URL=__LICENSE_SERVER_URL__

# Remote delivery-note signing links (server/src/main.ts's handleSignPage)
# MUST be tenant-specific — every tenant runs as its own process with
# its own database, so a signing link generated by one tenant can only
# ever be resolved by THAT tenant's process. Before this was added,
# every tenant silently fell back to the same hardcoded
# https://sign.doc-capture.app default (see delivery-notes.service.ts's
# createSigningLink), meaning only whichever ONE tenant Cloudflare
# Tunnel happened to route that shared hostname to could ever actually
# open a signing link — every other tenant's links always failed with
# "link not found", because the request landed on a process whose
# database has no idea that token exists.
#
# Needs a matching Cloudflare Tunnel route + DNS record for
# sign.__SLUG__.doc-capture.app pointing at this tenant's own port —
# provision-tenant.sh does not do that part for you (see its own
# printed instructions at the end).
SIGN_BASE_URL=https://sign.__SLUG__.doc-capture.app

# Fill in if this tenant uses Gmail order intake / Google Calendar sync
# — same per-tenant setup as documented in docs/installation-guide.md,
# just done once per tenant instead of once globally.
